# Configuração do Backend SPDealer
# Variáveis de ambiente para Spring Boot

# Banco de Dados
DB_HOST=100.126.166.63
DB_PORT=3306
DB_NAME=erp
DB_USER=root
DB_PASSWORD=k15720

# Servidor
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://100.126.166.63:3000,http://100.126.166.63:8080,http://192.168.10.100:3000,http://192.168.10.100:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# Frontend
FRONTEND_URL=http://localhost:3000

# Segurança
JWT_SECRET=spdealer_secret_key_production_should_be_complex
JWT_EXPIRATION_MS=86400000

# Logging
LOGGING_LEVEL=INFO

# CPF OAuth (preencha com credenciais reais)
# Substitua `your-cpf-client-id-here` e `your-cpf-client-secret-here` pelas credenciais fornecidas
CPF_OAUTH_CLIENT_ID=your-cpf-client-id-here
CPF_OAUTH_CLIENT_SECRET=your-cpf-client-secret-here
