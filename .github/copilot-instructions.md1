# Opção 2: SQL direto via -e (VALIDAR SEM ACENTOS ANTES)
mysql -h 100.126.166.63 -u root -pk15720 erp -e "INSERT INTO task_management (task_id, title, description, current_stage_id, priority_key, due_date, tags, category_key, created_by_user_id, estimated_hours) VALUES ('TASK-101-CADASTRO-CLIENTES', 'Revisao e Ajuste - Cadastro de Clientes', 'Revisar e ajustar modulo...', 2, 'HIGH', '2025-11-08', 'cadastro,clientes', 'Feature', 1, 8.0);"
