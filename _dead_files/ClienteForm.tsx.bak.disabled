import React, { useState } from 'react';
import styled from 'styled-components';
import { Cliente } from 'cliente';
import { ClienteService } from 'services/ClienteService';

interface ClienteFormProps {
  cliente?: Cliente;
  onSalvo?: (cliente: Cliente) => void;
}

const FormContainer = styled.div`
  padding: 20px;
  background: #fff;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.06);
`;

const FormGrid = styled.div`
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
  margin-bottom: 16px;
`;

const FormGroup = styled.div`
  display: flex;
  flex-direction: column;
  gap: 6px;
`;

const LabelLeft = styled.label`
  font-size: 13px;
  font-weight: 600;
  color: #374151;
`;

const Input = styled.input`
  height: 40px;
  box-sizing: border-box;
  padding: 8px 12px;
  border: 2px solid #e5e7eb;
  border-radius: 6px;
  font-size: 14px;
  &:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.08); }
`;

const ButtonGroup = styled.div`
  display:flex; justify-content:flex-end; gap:12px; margin-top:12px; padding-top:12px; border-top:1px solid #e5e7eb;
`;

const Button = styled.button<{ $variant?: 'primary' | 'secondary' }>`
  padding: 10px 18px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;
  ${props => props.$variant === 'primary' ? `background:#3b82f6;color:#fff` : `background:#6b7280;color:#fff`}
`;

export const ClienteForm: React.FC<ClienteFormProps> = ({ cliente, onSalvo }) => {
  const [form, setForm] = useState<Cliente>(cliente || {
    id: 0,
    nome: '',
    cpfCnpj: '',
    email: '',
    telefone: '',
    endereco: '',
    ativo: true
  });
  const [loading, setLoading] = useState(false);
  const [erro, setErro] = useState<string | null>(null);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const { name, value, type, checked } = e.target;
    setForm(prev => ({ ...prev, [name]: type === 'checkbox' ? checked : value } as any));
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    setErro(null);
    try {
      const salvo = await ClienteService.salvar(form);
      if (onSalvo) onSalvo(salvo);
    } catch (err: any) {
      setErro(err.message || 'Erro ao salvar');
    } finally {
      setLoading(false);
    }
  };

  return (
    <FormContainer>
      <form onSubmit={handleSubmit}>
        <FormGrid>
          <FormGroup>
            <LabelLeft>Nome</LabelLeft>
            <Input name="nome" value={form.nome} onChange={handleChange} required />
          </FormGroup>

          <FormGroup>
            <LabelLeft>CPF / CNPJ</LabelLeft>
            <Input name="cpfCnpj" value={form.cpfCnpj} onChange={handleChange} required />
          </FormGroup>

          <FormGroup>
            <LabelLeft>E-mail</LabelLeft>
            <Input name="email" value={form.email} onChange={handleChange} />
          </FormGroup>

          <FormGroup>
            <LabelLeft>Telefone</LabelLeft>
            <Input name="telefone" value={form.telefone} onChange={handleChange} />
          </FormGroup>

          <FormGroup style={{ gridColumn: '1 / -1' }}>
            <LabelLeft>Endereço</LabelLeft>
            <Input name="endereco" value={form.endereco} onChange={handleChange} />
          </FormGroup>

          <FormGroup style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <input id="ativo" type="checkbox" name="ativo" checked={!!form.ativo} onChange={handleChange} />
            <LabelLeft htmlFor="ativo">Ativo</LabelLeft>
          </FormGroup>
        </FormGrid>

        <ButtonGroup>
          <Button type="button" $variant="secondary" onClick={() => { if (!loading && onSalvo) onSalvo(form); }}>Cancelar</Button>
          <Button type="submit" $variant="primary" disabled={loading}>{loading ? 'Salvando...' : 'Salvar'}</Button>
        </ButtonGroup>
        {erro && <div style={{ color: 'red', marginTop: 8 }}>{erro}</div>}
      </form>
    </FormContainer>
  );
};













