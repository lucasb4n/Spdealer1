  <property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
  
  <parameter name="TITULO_RELATORIO" class="java.lang.String">
    <defaultValueExpression><![CDATA["RELATÓRIO DE FLUXO DE CAIXA"]]></defaultValueExpression>
  </parameter>
  <parameter name="DATA_INICIAL" class="java.lang.String"/>
  <parameter name="DATA_FINAL" class="java.lang.String"/>
  <parameter name="EMPRESA_NOME" class="java.lang.String"/>
  <parameter name="EMPRESA_CNPJ" class="java.lang.String"/>
  <parameter name="USUARIO" class="java.lang.String"/>
  <parameter name="FILTRO_COBRANCA" class="java.lang.String"/>
  <parameter name="FILTRO_DOCUMENTO" class="java.lang.String"/>
  <parameter name="FILTRO_SO_PAGOS" class="java.lang.Boolean"/>
  <parameter name="FILTRO_APENAS_ABERTOS" class="java.lang.Boolean"/>
  
  <queryString language="SQL"><![CDATA[SELECT 'RECEBER' as tipo, codigo_rec as codigo, numdup_rec as documento, nome_cli as pessoa FROM receber WHERE vlrsal_rec > 0
UNION ALL
SELECT 'PAGAR' as tipo, codigo_pag as codigo, numdup_pag as documento,
  (SELECT COALESCE(c.nome_cli,'') FROM clientes c WHERE c.codigo_cli = pagar.codigo_pag AND c.cliforn_cli = 'F' LIMIT 1) as pessoa
FROM pagar WHERE vlrsal_pag > 0 LIMIT 100]]></queryString>
  <field name="tipo" class="java.lang.String"/>
  <field name="codigo" class="java.lang.Integer"/>
  <field name="documento" class="java.lang.String"/>
  <field name="pessoa" class="java.lang.String"/>
