  <field name="valor" class="java.math.BigDecimal"/>
  <field name="saldo" class="java.math.BigDecimal"/>

  <variable name="TOTAL_ENTRADAS" class="java.math.BigDecimal" calculation="Sum">
    <variableExpression><![CDATA["ENTRADA".equals($F{tipo}) ? $F{valor} : BigDecimal.ZERO]]></variableExpression>
    <initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
  </variable>
  <variable name="TOTAL_SAIDAS" class="java.math.BigDecimal" calculation="Sum">
    <variableExpression><![CDATA["SAÍDA".equals($F{tipo}) ? $F{valor} : BigDecimal.ZERO]]></variableExpression>
    <initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
  </variable>

