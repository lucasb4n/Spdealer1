    <!-- Detail Band - Larguras ajustadas correspondentes aos headers -->
    <detail>
        <band height="14">
            <!-- Código -->
            <textField>
                <reportElement x="0" y="0" width="20" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{codigo_pag}]]></textFieldExpression>
            </textField>
            <!-- Documento -->
            <textField>
                <reportElement x="20" y="0" width="30" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{numdup_pag}]]></textFieldExpression>
            </textField>
            <!-- Parcela -->
            <textField>
                <reportElement x="50" y="0" width="15" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{parcela_pag}]]></textFieldExpression>
            </textField>
            <!-- CNPJ/CPF -->
            <textField>
                <reportElement x="65" y="0" width="24" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{cgccpf_pag}]]></textFieldExpression>
            </textField>
            <!-- Fornecedor -->
            <textField>
                <reportElement x="89" y="0" width="54" height="14"/>
                <textElement textAlignment="Left"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{fornecedor_nome} != null ? ($F{fornecedor_nome}.length() > 20 ? $F{fornecedor_nome}.substring(0,20) + "..." : $F{fornecedor_nome}) : ""]]></textFieldExpression>
            </textField>
            <!-- Celular -->
            <textField>
                <reportElement x="143" y="0" width="30" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{celular_cli} != null && !$F{celular_cli}.isEmpty() ? "(" + $F{celular_cli}.substring(0, Math.min(2, $F{celular_cli}.length())) + ") " + (($F{celular_cli}.length() >= 8) ? $F{celular_cli}.substring($F{celular_cli}.length()-8, $F{celular_cli}.length()-4) + "-" + $F{celular_cli}.substring($F{celular_cli}.length()-4) : $F{celular_cli}) : "-"]]></textFieldExpression>
            </textField>
            <!-- Dt Movimento -->
            <textField pattern="dd/MM/yyyy">
                <reportElement x="173" y="0" width="16" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{dtmovi_pag}]]></textFieldExpression>
            </textField>
            <!-- Dt Vencimento -->
            <textField pattern="dd/MM/yyyy">
                <reportElement x="189" y="0" width="16" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{dtvenci_pag}]]></textFieldExpression>
            </textField>
            <!-- Dt Pagamento -->
            <textField pattern="dd/MM/yyyy">
                <reportElement x="205" y="0" width="16" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{dtpagi_pag} != null ? $F{dtpagi_pag} : null]]></textFieldExpression>
            </textField>
            <!-- Valor Duplicata -->
            <textField pattern="#,##0.00">
                <reportElement x="221" y="0" width="16" height="14"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{vlrdup_pag} != null ? $F{vlrdup_pag} : 0.0]]></textFieldExpression>
            </textField>
            <!-- Juros -->
            <textField pattern="#,##0.00">
                <reportElement x="237" y="0" width="16" height="14"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{vlracre_pag} != null ? $F{vlracre_pag} : 0.0]]></textFieldExpression>
            </textField>
            <!-- Valor Pago -->
            <textField pattern="#,##0.00">
                <reportElement x="253" y="0" width="16" height="14"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{vlrpag_pag} != null ? $F{vlrpag_pag} : 0.0]]></textFieldExpression>
            </textField>
            <!-- Dias em Atraso -->
            <textField>
                <reportElement x="269" y="0" width="40" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{dtvenci_pag} != null && $F{dtvenci_pag}.before(new java.util.Date()) ? ((int)((new java.util.Date().getTime() - $F{dtvenci_pag}.getTime()) / 86400000)) : 0]]></textFieldExpression>
            </textField>
            <!-- Espaço para observações -->
            <staticText>
                <reportElement x="309" y="0" width="453" height="14"/>
                <textElement textAlignment="Left"><font size="7"/></textElement>
                <text><![CDATA[]]></text>
            </staticText>
        </band>
