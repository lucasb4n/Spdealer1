<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="contasapagar" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762" leftMargin="20" rightMargin="40" topMargin="30" bottomMargin="30" uuid="c22f6f3a-0000-4d2f-9c3a-000000000001">

    <parameter name="TITULO_RELATORIO" class="java.lang.String">
        <defaultValueExpression><![CDATA["CONTAS A PAGAR"]]></defaultValueExpression>
    </parameter>
    <parameter name="DATA_INICIAL" class="java.lang.String"/>
    <parameter name="DATA_FINAL" class="java.lang.String"/>
    <parameter name="FILIAL" class="java.lang.String"/>
    <parameter name="EMPRESA_NOME" class="java.lang.String"/>
    <parameter name="EMPRESA_CNPJ" class="java.lang.String"/>
    <parameter name="USUARIO" class="java.lang.String"/>
    <parameter name="FILTRO_COBRANCA" class="java.lang.String"/>
    <parameter name="FILTRO_DOCUMENTO" class="java.lang.String"/>
    <parameter name="FILTRO_SO_PAGOS" class="java.lang.Boolean"/>
    <parameter name="FILTRO_APENAS_ABERTOS" class="java.lang.Boolean"/>
    <parameter name="tipoCampoData" class="java.lang.String">
        <defaultValueExpression><![CDATA["dtvenci_pag"]]></defaultValueExpression>
    </parameter>
    <parameter name="dataini" class="java.lang.String"/>
    <parameter name="datafim" class="java.lang.String"/>
    <parameter name="SUBREPORT_CABECALHO" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["reports/templates/"]]></defaultValueExpression>
    </parameter>

    <!-- Consulta principal com filtro dinâmico por tipo de data -->
    <queryString>
        <![CDATA[SELECT 
                    p.pagar_id,
                    p.filial_pag,
                    p.codigo_pag,
                    p.numdup_pag,
                    p.parcela_pag,
                    CASE WHEN p.tipopessoa_pag = 'F' THEN 
                        CONCAT(SUBSTRING(LPAD(p.cgccpf_pag,11,'0'),1,3),'.',SUBSTRING(LPAD(p.cgccpf_pag,11,'0'),4,3),'.',SUBSTRING(LPAD(p.cgccpf_pag,11,'0'),7,3),'-',SUBSTRING(LPAD(p.cgccpf_pag,11,'0'),10,2))
                    WHEN p.tipopessoa_pag = 'J' THEN
                        CONCAT(SUBSTRING(LPAD(p.cgccpf_pag,14,'0'),1,2),'.',SUBSTRING(LPAD(p.cgccpf_pag,14,'0'),3,3),'.',SUBSTRING(LPAD(p.cgccpf_pag,14,'0'),6,3),'/',SUBSTRING(LPAD(p.cgccpf_pag,14,'0'),9,4),'-',SUBSTRING(LPAD(p.cgccpf_pag,14,'0'),13,2))
                    ELSE p.cgccpf_pag END AS cgccpf_pag,
                    p.dtmovi_pag,
                    p.dtvenci_pag,
                    p.dtpagi_pag,
                    p.vlrdup_pag,
                    p.vlracre_pag,
                    p.vlrpag_pag,
                    f.celular_cli,
                    COALESCE(f.nome_cli, '') AS fornecedor_nome
                FROM pagar p
                LEFT JOIN clientes f ON p.codigo_pag = f.codigo_cli AND f.cliforn_cli = 'F'
                                WHERE p.filial_pag = $P{FILIAL}
                                    AND p.vlrsal_pag > 0
                                    AND (p.status_pag IS NULL OR p.status_pag = '')
                  AND (
                    CASE WHEN $P{tipoCampoData} = 'dtmovi_pag' THEN p.dtmovi_pag BETWEEN $P{dataini} AND $P{datafim}
                         WHEN $P{tipoCampoData} = 'dtvenci_pag' THEN p.dtvenci_pag BETWEEN $P{dataini} AND $P{datafim}
                         WHEN $P{tipoCampoData} = 'dtpagi_pag' THEN p.dtpagi_pag BETWEEN $P{dataini} AND $P{datafim}
                         WHEN $P{tipoCampoData} = 'dtfluxo_pag' THEN p.dtmovi_pag BETWEEN $P{dataini} AND $P{datafim}
                         ELSE p.dtvenci_pag BETWEEN $P{dataini} AND $P{datafim}
                    END
                  )
                ORDER BY p.dtvenci_pag ASC, p.codigo_pag ASC]]>
    </queryString>

    <!-- Campos -->
    <field name="pagar_id" class="java.lang.Integer"/>
    <field name="filial_pag" class="java.lang.String"/>
    <field name="codigo_pag" class="java.lang.Integer"/>
    <field name="numdup_pag" class="java.lang.String"/>
    <field name="parcela_pag" class="java.lang.String"/>
    <field name="cgccpf_pag" class="java.lang.String"/>
    <field name="dtmovi_pag" class="java.sql.Date"/>
    <field name="dtvenci_pag" class="java.sql.Date"/>
    <field name="dtpagi_pag" class="java.sql.Date"/>
    <field name="vlrdup_pag" class="java.lang.Double"/>
    <field name="vlracre_pag" class="java.lang.Double"/>
    <field name="vlrpag_pag" class="java.lang.Double"/>
    <field name="celular_cli" class="java.lang.String"/>
    <field name="fornecedor_nome" class="java.lang.String"/>

    <title>
