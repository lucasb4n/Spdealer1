<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperTemplate PUBLIC "-//JasperReports//DTD Template//EN" "http://jasperreports.sourceforge.net/dtds/jaspertemplate.dtd">
<jasperTemplate>
    <style name="Title" fontSize="16" isBold="true"/>
    <style name="SubTitle" fontSize="12" isBold="true"/>
    <style name="ColumnHeader" fontSize="10" isBold="true" backcolor="#EEEEEE" mode="Opaque"/>
    <style name="Detail" fontSize="10"/>
    <style name="Row" mode="Transparent"/>
</jasperTemplate>
