<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="BaseTemplate_portrait" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40"
    topMargin="20" bottomMargin="20">
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySQL Connector"/>

    <!-- Estilos -->
    <style name="Title" fontSize="14" isBold="true"/>
    <style name="SubTitle" fontSize="11" isBold="true"/>
    <style name="ColumnHeader" fontSize="9" isBold="true" backcolor="#EEEEEE"/>
    <style name="Detail" fontSize="9"/>

    <!-- Parâmetros padrão -->
    <parameter name="EMPRESA_NOME" class="java.lang.String"/>
    <parameter name="EMPRESA_CNPJ" class="java.lang.String"/>
    <parameter name="USUARIO" class="java.lang.String"/>
    <parameter name="DATA_INICIAL" class="java.util.Date"/>
    <parameter name="DATA_FINAL" class="java.util.Date"/>
    
    <pageHeader>
        <band height="75" splitType="Stretch">
            <textField>
                <reportElement style="Title" x="0" y="0" width="350" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$P{EMPRESA_NOME}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="350" y="0" width="165" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement style="SubTitle" x="0" y="22" width="350" height="18"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$P{EMPRESA_CNPJ}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="350" y="22" width="165" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="0" y="45" width="250" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Usuário: " + $P{USUARIO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="45" width="265" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Período: " + 
                    ($P{DATA_INICIAL} != null ? new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{DATA_INICIAL}) : "") + 
                    " a " + 
                    ($P{DATA_FINAL} != null ? new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{DATA_FINAL}) : "")]]></textFieldExpression>
            </textField>
            
            <line>
                <reportElement x="0" y="65" width="515" height="1"/>
                <graphicElement><pen lineWidth="1.0"/></graphicElement>
            </line>
        </band>
    </pageHeader>
</jasperReport>
