{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": "src",
    "paths": {
      "dashboard": ["types/dashboard.ts"],
      "theme": ["types/theme.ts"],
      "CaixaBancos": ["types/CaixaBancos.ts"],
      "forms": ["types/forms.ts"],
      "menu": ["types/menu.ts"],
      "cliente": ["shared/types/cliente.ts"],
      "fornecedor": ["shared/types/fornecedor.ts"],
      "ClientesService": ["services/ClientesService.ts"],
      "maskUtils": ["utils/maskUtils.ts"],
      "gridPersonalization": ["types/gridPersonalization.ts"],
      "queryBuilder": ["types/queryBuilder.ts"],
      "flow": ["types/flow.ts"],
      "TaskManagement": ["types/TaskManagement.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx"
  ],
  "exclude": ["node_modules"]
}
